# Copy this file to .env.local and fill in your values.
# .env* is gitignored — never commit real secrets.
#
# Public Site
NEXT_PUBLIC_SITE_URL=https://fujifenix.com
NEXT_PUBLIC_GA_ID=G-K8N55C390S

# Sanity (public, used by the client)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-08-19

# Sanity (server-side only — do NOT prefix with NEXT_PUBLIC_)
SANITY_API_TOKEN=your-sanity-api-token

# Optional
FORMSPREE_ENDPOINT=https://formspree.io/f/xxxx
NEXT_PUBLIC_SOCKET_URL=wss://socket.fujifenix.com